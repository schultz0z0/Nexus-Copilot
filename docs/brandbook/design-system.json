      "dataRules": [
        "Keep fixtures separate from persisted campaigns",
        "Unavailable is not zero",
        "Cold contacts and WhatsApp clicks are not captured leads",
        "Aggregate reports do not create people or fill a person-level funnel",
        "Revisions replace measured values and preserve history",
