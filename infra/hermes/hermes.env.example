# Copie este arquivo para um arquivo local não versionado antes do deploy.
# Gere API_SERVER_KEY com um gerador criptograficamente seguro (mínimo: 8 caracteres).

HERMES_PROFILE_NAME=ens
HERMES_DATA_VOLUME_NAME=ens-hermes-data
NEXUS_MARKETING_OPS_MCP_URL=http://marketing-ops:3001/mcp
API_SERVER_KEY=

# O dashboard fica sem OAuth no Compose base local. Em produção, configure o
# client ID da Nous e mantenha a URL pública coerente com o router Traefik.
HERMES_DASHBOARD_OAUTH_CLIENT_ID=
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.solucoes-nexus.tech
NEXUS_PUBLIC_HERMES_DASHBOARD_HOST=hermes.solucoes-nexus.tech
NEXUS_TRAEFIK_ENTRYPOINT=websecure
NEXUS_TRAEFIK_CERT_RESOLVER=letsencrypt
