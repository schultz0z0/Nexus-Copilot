FROM restic/restic:0.17.3@sha256:8f5a62b422a2cb1277ea0dd6e826fe1acf649e5b9f02d60e5268d5fd1976255a AS restic

FROM postgres:18.6-bookworm@sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af

COPY --from=restic /usr/bin/restic /usr/local/bin/restic

RUN useradd -u 10001 -U -m -s /bin/sh nexus_ops \
  && mkdir -p /var/lib/nexus-backup/status /var/lib/nexus-backup/restic /opt/nexus-postgres/ops \
  && chown -R nexus_ops:nexus_ops /var/lib/nexus-backup /opt/nexus-postgres

COPY --chown=nexus_ops:nexus_ops ops/ /opt/nexus-postgres/ops/
RUN chmod 0755 /opt/nexus-postgres/ops/*.sh

USER nexus_ops
WORKDIR /var/lib/nexus-backup
