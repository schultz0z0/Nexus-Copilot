FROM node:22.23.2-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

WORKDIR /opt/nexus-postgres

COPY --chown=node:node infra/postgres/package.json infra/postgres/package-lock.json ./
RUN npm ci --omit=dev

COPY --chown=node:node infra/postgres/src ./src
COPY --chown=node:node infra/postgres/migrations ./migrations

USER node

ENTRYPOINT ["node", "src/migrate.mjs"]

