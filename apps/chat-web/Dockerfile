FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ARG VITE_APP_API_URL=""
ARG VITE_CHAT_STREAM_FILE_HOSTS=""
ARG VITE_MARKETING_OPS_ENABLED="false"
ARG VITE_MARKETING_OPS_READ="false"
ARG VITE_MARKETING_OPS_WRITE="false"
ARG VITE_MARKETING_OPS_APPROVALS="false"
ARG VITE_MARKETING_OPS_KILL_SWITCH="false"
ENV VITE_APP_API_URL=$VITE_APP_API_URL \
    VITE_CHAT_STREAM_FILE_HOSTS=$VITE_CHAT_STREAM_FILE_HOSTS \
    VITE_MARKETING_OPS_ENABLED=$VITE_MARKETING_OPS_ENABLED \
    VITE_MARKETING_OPS_READ=$VITE_MARKETING_OPS_READ \
    VITE_MARKETING_OPS_WRITE=$VITE_MARKETING_OPS_WRITE \
    VITE_MARKETING_OPS_APPROVALS=$VITE_MARKETING_OPS_APPROVALS \
    VITE_MARKETING_OPS_KILL_SWITCH=$VITE_MARKETING_OPS_KILL_SWITCH
RUN npm run build



FROM nginx:1.27-alpine

RUN addgroup -g 1001 -S app && adduser -S -D -H -u 1001 -G app app

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

RUN chown -R 1001:1001 /usr/share/nginx/html

USER 1001

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
