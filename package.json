{
  "name": "ens-migration-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:chat-web && npm run build:marketing-ops",
    "build:chat-web": "npm --prefix apps/chat-web run build",
    "build:marketing-ops": "npm --prefix services/marketing-ops run build",
    "test": "npm run test:chat-web && npm run test:marketing-ops && npm run test:chat-bridge && npm run test:artifact-server && npm run test:app-api",
    "test:cut": "node --test test/cut/*.test.mjs",
    "test:hermes": "node --test test/hermes/*.test.mjs",
    "test:postgres:contract": "node --test test/postgres/*.test.mjs",
    "test:postgres:ops": "node --test test/postgres/ops-contract.test.mjs",
    "test:postgres": "npm run test:postgres:contract && npm --prefix infra/postgres test",
    "test:postgres:integration": "npm --prefix infra/postgres run test:integration",
    "test:supabase-ledger": "python -m unittest discover -s tools/supabase-ledger/tests -p \"test_*.py\"",
    "test:supabase-ledger:container": "docker compose -f tools/supabase-ledger/compose.yaml run --rm test",
    "scan:supabase-ledger": "python tools/supabase-ledger/ledger.py scan --policy docs/migration/supabase-ledger/source-policy.json --manifest docs/migration/supabase-ledger/source-manifest.json --decisions docs/migration/supabase-ledger/object-decisions.json --report docs/migration/supabase-ledger/supabase-object-ledger.md --reviews docs/migration/supabase-ledger/reviews",
    "verify:supabase-ledger": "python tools/supabase-ledger/ledger.py verify --manifest docs/migration/supabase-ledger/source-manifest.json --decisions docs/migration/supabase-ledger/object-decisions.json --report docs/migration/supabase-ledger/supabase-object-ledger.md --reviews docs/migration/supabase-ledger/reviews",
    "verify:supabase-ledger:container": "docker compose -f tools/supabase-ledger/compose.yaml run --rm verify",
    "render:supabase-ledger": "python tools/supabase-ledger/ledger.py render --manifest docs/migration/supabase-ledger/source-manifest.json --decisions docs/migration/supabase-ledger/object-decisions.json --report docs/migration/supabase-ledger/supabase-object-ledger.md --reviews docs/migration/supabase-ledger/reviews",
    "test:chat-web": "npm --prefix apps/chat-web test",
    "test:marketing-ops": "npm --prefix services/marketing-ops test",
    "test:chat-bridge": "npm --prefix services/chat-bridge test",
    "test:artifact-server": "npm --prefix services/artifact-server test",
    "test:app-api": "npm --prefix services/app-api test",
    "smoke:hermes": "node scripts/smoke-hermes-runtime.mjs",
    "typecheck": "npm run typecheck:chat-web && npm run typecheck:marketing-ops",
    "typecheck:chat-web": "npm --prefix apps/chat-web run typecheck",
    "typecheck:marketing-ops": "npm --prefix services/marketing-ops run typecheck",
    "verify:cut": "node scripts/verify-initial-cut.mjs",
    "validate:hermes-profile": "node scripts/validate-hermes-distribution.mjs agents/ens"
  },
  "engines": {
    "node": ">=22"
  }
}
